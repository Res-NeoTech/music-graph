# .env est lu par Docker Compose, Next.js et le script d'import.

# --- PostgreSQL ---
POSTGRES_USER=musicgraph
POSTGRES_PASSWORD=change-me
POSTGRES_DB=musicgraph
POSTGRES_PORT=5433
DATABASE_URL=postgres://musicgraph:change-me@localhost:5433/musicgraph

# --- ArangoDB ---
ARANGO_ROOT_PASSWORD=change-me
ARANGO_PORT=8529
ARANGO_URL=http://localhost:8529
# Base créée par le script d'import
ARANGO_DATABASE=music_graph
ARANGO_USER=root
ARANGO_PASSWORD=change-me
